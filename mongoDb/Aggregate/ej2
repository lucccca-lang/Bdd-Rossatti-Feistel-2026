/*1*/

db.compras.aggregate([
  { $project: { _id: 0, cliente_idCliente: 1, id: 1, fecha: 1, productos: 1 } },
  { $sort: { cliente_idCliente: 1 } }
])

/*2*/

db.compras.aggregate([
  { $unwind: "$productos" },
  { $group: {
      _id: "$cliente_idCliente",
      total: { $sum: { $multiply: ["$productos.precio", "$productos.cantidad"] } }
  } },
  { $lookup: { from: "clientes", localField: "_id", foreignField: "codCliente", as: "cliente" } },
  { $unwind: "$cliente" },
  { $project: { _id: 0, nombre: "$cliente.nombre", apellido: "$cliente.apellido", total: 1 } }
])

/*3*/

db.compras.aggregate([
  { $unwind: "$productos" },
  { $group: {
      _id: { compra: "$id", cliente: "$cliente_idCliente" },
      totalCompra: { $sum: { $multiply: ["$productos.precio", "$productos.cantidad"] } }
  } },
  { $group: {
      _id: "$_id.cliente",
      masCaro: { $max: "$totalCompra" },
      masBarato: { $min: "$totalCompra" },
      promedio: { $avg: "$totalCompra" }
  } },
  { $lookup: { from: "clientes", localField: "_id", foreignField: "codCliente", as: "cliente" } },
  { $unwind: "$cliente" },
  { $project: { _id: 0, nombre: "$cliente.nombre", apellido: "$cliente.apellido", masCaro: 1, masBarato: 1, promedio: 1 } }
])

/*4*/

db.compras.aggregate([
  { $project: { id: 1, cliente_idCliente: 1, cantidad_productos: { $size: "$productos" } } },
  { $sort: { cantidad_productos: -1 } },
  { $limit: 1 },
  { $lookup: { from: "clientes", localField: "cliente_idCliente", foreignField: "codCliente", as: "cliente" } },
  { $unwind: "$cliente" },
  { $project: { _id: 0, id: 1, cantidad_productos: 1, nombre: "$cliente.nombre" } }
])

/*5*/

db.compras.aggregate([
  { $group: { _id: "$cliente_idCliente", cantidad_compras: { $sum: 1 } } },
  { $match: { cantidad_compras: { $gt: 2 } } },
  { $lookup: { from: "clientes", localField: "_id", foreignField: "codCliente", as: "cliente" } },
  { $unwind: "$cliente" },
  { $project: { _id: 0, codCliente: "$_id", nombre: "$cliente.nombre", apellido: "$cliente.apellido" } }
])

/*6*/

db.compras.aggregate([
  { $unwind: "$productos" },
  { $project: {
      anio: { $year: { $dateFromString: { dateString: "$fecha", format: "%Y-%m-%d" } } },
      mes: { $month: { $dateFromString: { dateString: "$fecha", format: "%Y-%m-%d" } } },
      cantidad: "$productos.cantidad"
  } },
  { $group: { _id: { anio: "$anio", mes: "$mes" }, unidades: { $sum: "$cantidad" } } },
  { $sort: { "_id.anio": 1, "_id.mes": 1 } }
])

/*7*/

db.compras.aggregate([
  { $project: {
      cliente_idCliente: 1,
      anio: { $year: { $dateFromString: { dateString: "$fecha", format: "%Y-%m-%d" } } },
      mes: { $month: { $dateFromString: { dateString: "$fecha", format: "%Y-%m-%d" } } }
  } },
  { $group: {
      _id: { cliente: "$cliente_idCliente", anio: "$anio", mes: "$mes" },
      cantidad_compras: { $sum: 1 }
  } },
  { $sort: { "_id.cliente": 1, "_id.anio": 1, "_id.mes": 1 } }
])

/*8*/

db.compras.aggregate([
  { $unwind: "$productos" },
  { $project: {
      anio: { $year: { $dateFromString: { dateString: "$fecha", format: "%Y-%m-%d" } } },
      subtotal: { $multiply: ["$productos.precio", "$productos.cantidad"] }
  } },
  { $group: { _id: "$anio", ganancia: { $sum: "$subtotal" } } },
  { $sort: { ganancia: -1 } },
  { $limit: 1 }
])

/*1*/

db.Clientes.aggregate([
  {
    $group: {
      _id: null,
      promedio_edad: { $avg: "$edad" }
    }
  }
])

/*2*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $unwind: "$compras.productos" },
  {
    $group: {
      _id: {
        id: "$compras.productos.id",
        descripcion: "$compras.productos.descripcion"
      },
      total_unidades: { $sum: "$compras.productos.cantidad" }
    }
  }
])


/*4*/

db.clientes.aggregate([
  {
    $project: {
      nombre: 1,
      apellido: 1,
      cantidad_compras: { $size: "$compras" }
    }
  },
  {
    $match: {
      cantidad_compras: { $gt: 2 }
    }
  }
])

/*5*/

db.clientes.aggregate([
  {
    $project: {
      nombre: 1,
      apellido: 1,
      cantidad_compras: { $size: "$compras" }
    }
  },
  { $sort: { cantidad_compras: -1 } },
  { $limit: 1 }
])

/*6*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $unwind: "$compras.productos" },
  {
    $group: {
      _id: {
        dni: "$dni",
        id_compra: "$compras.id"
      },
      unidades_compra: { $sum: "$compras.productos.cantidad" }
    }
  },
  {
    $group: {
      _id: null,
      promedio_unidades: { $avg: "$unidades_compra" }
    }
  }
])


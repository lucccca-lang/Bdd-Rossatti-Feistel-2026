/*1*/

db.clientes.aggregate([
  { $group: { _id: null, promedioEdad: { $avg: "$edad" } } }
])

/*2*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $unwind: "$compras.productos" },
  { $group: {
      _id: "$compras.productos.id",
      descripcion: { $first: "$compras.productos.descripcion" },
      totalUnidades: { $sum: "$compras.productos.cantidad" }
  } }
])

/*3*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $unwind: "$compras.productos" },
  { $group: {
      _id: "$dni",
      nombre: { $first: "$nombre" },
      apellido: { $first: "$apellido" },
      totalGastado: { $sum: { $multiply: ["$compras.productos.precio", "$compras.productos.cantidad"] } }
  } }
])

/*4*/

db.clientes.aggregate([
  { $project: { nombre: 1, apellido: 1, cantidad_compras: { $size: "$compras" } } },
  { $match: { cantidad_compras: { $gt: 2 } } }
])

/*5*/

db.clientes.aggregate([
  { $project: { nombre: 1, apellido: 1, cantidad_compras: { $size: "$compras" } } },
  { $sort: { cantidad_compras: -1 } },
  { $limit: 1 }
])

/*6*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $project: { unidades: { $sum: "$compras.productos.cantidad" } } },
  { $group: { _id: null, promedioUnidades: { $avg: "$unidades" } } }
])

/*7*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $unwind: "$compras.productos" },
  { $group: {
      _id: "$compras.productos.id",
      descripcion: { $first: "$compras.productos.descripcion" },
      cantidad_compras: { $sum: 1 }
  } }
])

/*8*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $match: { "compras.fecha": "2026-10-29" } },
  { $unwind: "$compras.productos" },
  { $group: {
      _id: null,
      totalHoy: { $sum: { $multiply: ["$compras.productos.precio", "$compras.productos.cantidad"] } }
  } }
])

/*9*/

db.clientes.aggregate([
  { $unwind: "$compras" },
  { $project: { unidades: { $sum: "$compras.productos.cantidad" } } },
  { $group: { _id: null, minimo: { $min: "$unidades" }, maximo: { $max: "$unidades" } } }
])
